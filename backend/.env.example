# Get an API key from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Get an API key from aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Gemini model override
GEMINI_MODEL=gemini-3.7-flash
SECRET_KEY=

# Hosted transcription (preferred when configured)
DEEPGRAM_API_KEY=
# Hosted summaries (preferred when configured)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
